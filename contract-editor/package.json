{
  "name": "contract-editor",
  "private": true,
  "description": "合約共同編輯器：機關與廠商共同修訂契約（Cloudflare Pages + D1 + R2）",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=local-db --r2 IMAGES=local-img --binding ADMIN_PASSWORD=dev-password",
    "lint": "eslint .",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node test/e2e/contract-flow.mjs && node test/e2e/all-pages.mjs",
    "build:template": "node scripts/build-template.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "docx": "8.5.0",
    "dompurify": "3.0.6",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "html2canvas": "1.4.1",
    "jsdom": "24.1.3",
    "jspdf": "2.5.1",
    "jszip": "3.10.1",
    "mammoth": "1.6.0",
    "wrangler": "3.99.0"
  }
}
